{
  "name": "dsh-restart-resume",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: after a clean dsh restart, automatically resumes sessions whose last turn was closed as aborted/disposed (host disposal) — the signal every existing resume plugin skips.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "resume",
    "restart",
    "disposed",
    "auto-continue"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
